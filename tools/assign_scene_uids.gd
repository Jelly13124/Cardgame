extends SceneTree

## Gives every project scene without a header uid one generated by Godot itself
## (ResourceUID.create_id / id_to_text), so scenes can be referenced as uid://.
## Only the first line of each scene changes. Run from the project root:
##
##   godot --headless --path . --script res://tools/assign_scene_uids.gd [-- --dry-run]
##
## Afterwards run `godot --headless --path . --import` so the editor cache
## registers the new uids.

const SKIP_DIRS := [".godot", ".superpowers", "addons"]
const HEADER_PREFIX := "[gd_scene"


func _init() -> void:
	var dry_run := "--dry-run" in OS.get_cmdline_user_args()
	var scenes: Array[String] = []
	_collect("res://", scenes)
	var taken := {}
	var missing: Array[String] = []
	for path in scenes:
		var header := _first_line(path)
		var uid := _header_uid(header)
		if uid == "":
			missing.append(path)
		else:
			taken[uid] = true
	var assigned := 0
	for path in missing:
		var uid_text := ""
		while uid_text == "" or taken.has(uid_text) or ResourceUID.has_id(ResourceUID.text_to_id(uid_text)):
			uid_text = ResourceUID.id_to_text(ResourceUID.create_id())
		taken[uid_text] = true
		if not dry_run and not _write_header_uid(path, uid_text):
			printerr("failed to update ", path)
			quit(1)
			return
		print(("would assign " if dry_run else "assigned ") + uid_text + " " + path)
		assigned += 1
	print(("would assign " if dry_run else "assigned ") + str(assigned))
	quit(0)


func _collect(dir_path: String, out: Array[String]) -> void:
	for d in DirAccess.get_directories_at(dir_path):
		if d in SKIP_DIRS:
			continue
		_collect(dir_path.path_join(d), out)
	for f in DirAccess.get_files_at(dir_path):
		if f.ends_with(".tscn"):
			out.append(dir_path.path_join(f))


func _first_line(path: String) -> String:
	var f := FileAccess.open(path, FileAccess.READ)
	return f.get_line() if f else ""


func _header_uid(header: String) -> String:
	var m := RegEx.create_from_string('uid="(uid://[a-z0-9]+)"').search(header)
	return m.get_string(1) if m else ""


func _write_header_uid(path: String, uid_text: String) -> bool:
	var text := FileAccess.get_file_as_string(path)
	var newline := text.find("\n")
	var header := text.substr(0, newline) if newline >= 0 else text
	if not header.begins_with(HEADER_PREFIX):
		return false
	var close := header.rfind("]")
	var updated := header.substr(0, close) + ' uid="%s"' % uid_text + header.substr(close)
	var f := FileAccess.open(path, FileAccess.WRITE)
	if f == null:
		return false
	f.store_string(updated + (text.substr(newline) if newline >= 0 else ""))
	f.close()
	return true
